# 复制为 server/.env.dev 后填写自己的值。
# .env.dev 含密钥，已被 .gitignore 忽略，不要提交。
APP_ENV=dev
HTTP_ADDR=:8088
DB_PATH=./data/app.db
JWT_SECRET=change-me-to-a-long-random-string
MAIL_POLL_MINUTES=0

# AI 分类（留空则关闭分类功能）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_BATCH_SIZE=30
